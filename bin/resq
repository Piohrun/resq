#!/bin/bash
# resq - CLI Wrapper
# Usage: resq [command] [args]

# Resolve install root (symlink safe).
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
RESQ_HOME="$(dirname "$DIR")"

# q claims -h for itself and dies with '-h before the script can read .z.x, so
# the short help flag has to be translated here rather than in the CLI parser.
# The same goes for -v: q rejects any single-letter option it does not know
# ('v invalid), so the documented short version flag never reached resQ.
# q also rejects a bare "--" ('- invalid), so the path separator is passed as
# -paths. Nothing after -args is touched: that part belongs to the application.
args=()
app_args=0
for a in "$@"; do
  if [ "$app_args" = 1 ]; then args+=("$a"); continue; fi
  case "$a" in
    -args|--args) app_args=1; args+=("$a") ;;
    -h) args+=("--help") ;;
    -v) args+=("--version") ;;
    --) args+=("-paths") ;;
    *) args+=("$a") ;;
  esac
done

# Run from the user's CWD so test/discover paths they pass in resolve
# against THEIR project, not the framework install. resq.q reads
# RESQ_HOME to find its own modules.
export RESQ_HOME

# Release qualification can select an explicit q binary; ordinary invocations
# retain the familiar PATH lookup.
q_bin="${QBIN:-q}"

# q honours `exit 0` immediately, even from test/application code, and its
# .z.exit callback cannot change that status. Supervise test-mode completion
# with a private marker directory so an early exit cannot make CI green.
guard_root="${TMPDIR:-/tmp}"
case "$guard_root" in
  /*) ;;
  *) guard_root="/tmp" ;;
esac
guard_root="${guard_root%/}"
guard_dir="$(mktemp -d "$guard_root/resq-run-guard.XXXXXXXX")" || {
  echo "resQ ERROR: unable to create process guard directory" >&2
  exit 1
}
chmod 700 "$guard_dir" || {
  echo "resQ ERROR: unable to secure process guard directory" >&2
  rmdir -- "$guard_dir" 2>/dev/null
  exit 1
}
isolate_root="$guard_dir/isolate"
mkdir -m 700 -- "$isolate_root" || {
  echo "resQ ERROR: unable to create private isolation root" >&2
  rm -rf -- "$guard_dir"
  exit 1
}

cleanup_guard() {
  # guard_dir is the exact absolute path returned by mktemp above. Isolation
  # scratch lives below it, so an interrupted launcher can reclaim children'
  # private artifacts without scanning or globbing in the caller's TMPDIR.
  rm -rf -- "$guard_dir"
}
trap cleanup_guard EXIT

child_pid=""
child_pgid=""

# Every process below the one given, from one listing of the process table.
# q's children are found here even when setsid and pkill are not installed:
# an isolated test file runs under `timeout`, which starts a process group of
# its own, so a signal sent to q, or to q's group, never reached it.
processes_below() {
  local root="$1" table pid ppid frontier next found=""
  table="$(ps -A -o pid= -o ppid= 2>/dev/null)" || return 0
  frontier=" $root "
  while [ "$frontier" != " " ]; do
    next=" "
    while read -r pid ppid; do
      case "$frontier" in *" $ppid "*) next="$next$pid "; found="$found $pid" ;; esac
    done <<< "$table"
    frontier="$next"
  done
  printf '%s\n' "$found"
}

# Signal q and everything it started: by session and by process group where
# q has its own, and process by process in every case.
signal_run() {
  local signal_name="$1" pid
  if [ -n "$child_pgid" ]; then
    if command -v pkill >/dev/null 2>&1; then
      pkill "-$signal_name" -s "$child_pgid" 2>/dev/null || true
    fi
    kill -s "$signal_name" -- "-$child_pgid" 2>/dev/null || true
  fi
  for pid in $(processes_below "$child_pid") "$child_pid"; do
    kill -s "$signal_name" -- "$pid" 2>/dev/null || true
  done
  # A pooled isolated child is started by a wrapper that outlives the shell
  # q started it from, so it is not below q any more. Each wrapper keeps the
  # child's PID, which leads its own process group, while the child runs.
  local pid_file
  for pid_file in "$isolate_root"/*/pid.txt; do
    [ -f "$pid_file" ] || continue
    pid=""
    read -r pid < "$pid_file" 2>/dev/null || true
    case "$pid" in ''|*[!0-9]*) continue ;; esac
    kill -s "$signal_name" -- "-$pid" 2>/dev/null || true
    kill -s "$signal_name" -- "$pid" 2>/dev/null || true
  done
}

terminate_for_signal() {
  local signal_name="$1"
  local exit_code="$2"
  trap - INT TERM HUP QUIT
  # q does not stop at a signal while it is busy. Tell the run first, in a
  # way it looks for: it then starts nothing new and writes no report or
  # state from a run that was cut short.
  printf '%s\n' "$exit_code" > "$guard_dir/interrupted" 2>/dev/null || true
  if [ -n "$child_pid" ] && kill -0 "$child_pid" 2>/dev/null; then
    signal_run "$signal_name"
    sleep 1
    if kill -0 "$child_pid" 2>/dev/null; then
      signal_run KILL
    fi
    wait "$child_pid" 2>/dev/null || true
  fi
  cleanup_guard
  trap - EXIT
  exit "$exit_code"
}
trap 'terminate_for_signal INT 130' INT
trap 'terminate_for_signal TERM 143' TERM
# q runs in its own session (setsid), so a hangup or a quit sent to this
# launcher never reaches it. Untrapped, either one killed the launcher and
# left the whole run alive: a closed terminal or SSH session, with a hung test
# then holding a licence for good.
trap 'terminate_for_signal HUP 129' HUP
trap 'terminate_for_signal QUIT 131' QUIT

export RESQ_RUN_GUARD_DIR="$guard_dir"
export RESQ_ISOLATE_ROOT="$isolate_root"
# q treats a leading flag as an option/value pair, so flag-only runtime options
# belong after the script path. Quiet startup keeps the banner out of the
# framework-output contract; runtime and application diagnostics may remain.
if command -v setsid >/dev/null 2>&1; then
  setsid "$q_bin" "$RESQ_HOME/resq.q" -q "${args[@]}" -e 1 &
  child_pid=$!
  child_pgid=$child_pid
else
  "$q_bin" "$RESQ_HOME/resq.q" -q "${args[@]}" -e 1 &
  child_pid=$!
fi
wait "$child_pid"
q_status=$?
child_pid=""
child_pgid=""

# With -noquit or "exit": false resQ does not call exit, and q, whose input
# is empty here, then ends with status 0 whatever the tests did. Take the
# run's own verdict when it left one.
if [ "$q_status" -eq 0 ] && [ -f "$guard_dir/verdict" ]; then
  verdict=""
  read -r verdict < "$guard_dir/verdict" 2>/dev/null || true
  case "$verdict" in
    ''|*[!0-9]*) ;;
    *) q_status="$verdict" ;;
  esac
fi

if [ "$q_status" -eq 0 ] && [ -f "$guard_dir/armed" ] &&
   { [ -f "$guard_dir/premature" ] || [ ! -f "$guard_dir/complete" ]; }; then
  echo "resQ ERROR: q exited before resQ completed; forcing a failing status." >&2
  q_status=1
fi

exit "$q_status"
