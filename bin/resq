#!/bin/bash
# resq - CLI Wrapper
# Usage: resq [command] [args]

# Resolve install root (symlink safe).
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
RESQ_HOME="$(dirname "$DIR")"

# q claims -h for itself and dies with '-h before the script can read .z.x, so
# the short help flag has to be translated here rather than in the CLI parser.
args=()
for a in "$@"; do
  if [ "$a" = "-h" ]; then args+=("--help"); else args+=("$a"); fi
done

# Run from the user's CWD so test/discover paths they pass in resolve
# against THEIR project, not the framework install. resq.q reads
# RESQ_HOME to find its own modules.
export RESQ_HOME

# Release qualification can select an explicit q binary; ordinary invocations
# retain the familiar PATH lookup.
q_bin="${QBIN:-q}"

# q honours `exit 0` immediately, even from test/application code, and its
# .z.exit callback cannot change that status. Supervise test-mode completion
# with a private marker directory so an early exit cannot make CI green.
guard_root="${TMPDIR:-/tmp}"
case "$guard_root" in
  /*) ;;
  *) guard_root="/tmp" ;;
esac
guard_root="${guard_root%/}"
guard_dir="$(mktemp -d "$guard_root/resq-run-guard.XXXXXXXX")" || {
  echo "resQ ERROR: unable to create process guard directory" >&2
  exit 1
}
chmod 700 "$guard_dir" || {
  echo "resQ ERROR: unable to secure process guard directory" >&2
  rmdir -- "$guard_dir" 2>/dev/null
  exit 1
}
isolate_root="$guard_dir/isolate"
mkdir -m 700 -- "$isolate_root" || {
  echo "resQ ERROR: unable to create private isolation root" >&2
  rm -rf -- "$guard_dir"
  exit 1
}

cleanup_guard() {
  # guard_dir is the exact absolute path returned by mktemp above. Isolation
  # scratch lives below it, so an interrupted launcher can reclaim children'
  # private artifacts without scanning or globbing in the caller's TMPDIR.
  rm -rf -- "$guard_dir"
}
trap cleanup_guard EXIT

child_pid=""
child_pgid=""
terminate_for_signal() {
  local signal_name="$1"
  local exit_code="$2"
  trap - INT TERM
  if [ -n "$child_pid" ] && kill -0 "$child_pid" 2>/dev/null; then
    if [ -n "$child_pgid" ]; then
      if command -v pkill >/dev/null 2>&1; then
        pkill "-$signal_name" -s "$child_pgid" 2>/dev/null || true
      fi
      kill -s "$signal_name" -- "-$child_pgid" 2>/dev/null || true
    else
      kill -s "$signal_name" -- "$child_pid" 2>/dev/null || true
    fi
    sleep 1
    if kill -0 "$child_pid" 2>/dev/null; then
      if [ -n "$child_pgid" ]; then
        if command -v pkill >/dev/null 2>&1; then
          pkill -KILL -s "$child_pgid" 2>/dev/null || true
        fi
        kill -KILL -- "-$child_pgid" 2>/dev/null || true
      else
        kill -KILL -- "$child_pid" 2>/dev/null || true
      fi
    fi
    wait "$child_pid" 2>/dev/null || true
  fi
  cleanup_guard
  trap - EXIT
  exit "$exit_code"
}
trap 'terminate_for_signal INT 130' INT
trap 'terminate_for_signal TERM 143' TERM

export RESQ_RUN_GUARD_DIR="$guard_dir"
export RESQ_ISOLATE_ROOT="$isolate_root"
# q treats a leading flag as an option/value pair, so flag-only runtime options
# belong after the script path. Quiet startup keeps the banner out of the
# framework-output contract; runtime and application diagnostics may remain.
if command -v setsid >/dev/null 2>&1; then
  setsid "$q_bin" "$RESQ_HOME/resq.q" -q "${args[@]}" -e 1 &
  child_pid=$!
  child_pgid=$child_pid
else
  "$q_bin" "$RESQ_HOME/resq.q" -q "${args[@]}" -e 1 &
  child_pid=$!
fi
wait "$child_pid"
q_status=$?
child_pid=""
child_pgid=""

if [ "$q_status" -eq 0 ] && [ -f "$guard_dir/armed" ] &&
   { [ -f "$guard_dir/premature" ] || [ ! -f "$guard_dir/complete" ]; }; then
  echo "resQ ERROR: q exited before resQ completed; forcing a failing status." >&2
  q_status=1
fi

exit "$q_status"
