        },
        {
          "test": "Running an Expectation :: should restage an expectation if the test run is to immediately halt",
          "upstream": "pass",
          "resq": "fail",
          "reason": "qspec's own runner-internals test of its private halt/restage state machine (.tst.runExpec / halt); outside the compatibility boundary (docs/QSPEC_COMPATIBILITY.md)."
        },
        {
          "test": "Test Loading :: should find all test files in a list of paths",
          "upstream": "pass",
          "resq": "error",
          "reason": "qspec's own loader-internals test: it calls qspec's private file finders and expects their exact return shapes (path strings); resQ's loader is different. Private runner APIs are outside the compatibility boundary (docs/QSPEC_COMPATIBILITY.md)."
        },
