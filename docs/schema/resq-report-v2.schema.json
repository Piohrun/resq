{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Piohrun/resq/schemas/resq-report-v2.schema.json",
  "title": "resQ test report v2",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "framework", "frameworkVersion", "run", "summary", "tests", "diagnostics"],
  "allOf": [
    {
      "if": {"required": ["profile"], "properties": {"profile": {"const": "full"}}},
      "then": {
        "required": ["completeness", "performance", "coverage", "flake", "snapshotInventory", "benchmarkAnalysis", "manifest", "events"],
        "properties": {"tests": {"type": "array", "items": {"$ref": "#/$defs/test"}}}
      }
    },
    {
      "if": {"required": ["profile"], "properties": {"profile": {"const": "results"}}},
      "then": {
        "required": ["completeness"],
        "properties": {
          "performance": false, "coverage": false, "flake": false,
          "snapshotInventory": false, "benchmarkAnalysis": false,
          "manifest": false, "events": false,
          "tests": {"type": "array", "items": {"$ref": "#/$defs/test"}}
        }
      }
    },
    {
      "if": {"required": ["profile"], "properties": {"profile": {"const": "telemetry"}}},
      "then": {
        "required": ["completeness"],
        "properties": {
          "performance": false, "coverage": false, "flake": false,
          "snapshotInventory": false, "benchmarkAnalysis": false,
          "manifest": false, "events": false,
          "tests": {"type": "array", "items": {"$ref": "#/$defs/telemetryTest"}}
        }
      }
    },
    {
      "if": {"not": {"required": ["profile"]}},
      "then": {
        "required": ["performance", "coverage"],
        "properties": {"tests": {"type": "array", "items": {"$ref": "#/$defs/test"}}}
      }
    }
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "framework": {"const": "resQ"},
    "frameworkVersion": {"type": "string", "minLength": 1},
    "run": {"$ref": "#/$defs/run"},
    "summary": {"$ref": "#/$defs/summary"},
    "profile": {"enum": ["full", "results", "telemetry"]},
    "completeness": {"$ref": "#/$defs/completeness"},
    "tests": {"type": "array"},
    "performance": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/legacyBenchmarkMeasurement"},
              {"$ref": "#/$defs/benchmarkMeasurement"}
            ]
          }
        },
        {"$ref": "#/$defs/legacyBenchmarkMeasurement"}
      ]
    },
    "coverage": {
      "oneOf": [
        {"type": "object", "maxProperties": 0},
        {"$ref": "#/$defs/coverageSummary"}
      ]
    },
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "flake": {"$ref": "#/$defs/flake"},
    "snapshotInventory": {"$ref": "#/$defs/snapshotInventory"},
    "benchmarkAnalysis": {"$ref": "#/$defs/benchmarkAnalysis"},
    "manifest": {"$ref": "#/$defs/manifest"},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "coverageGate": {
      "type": "object",
      "additionalProperties": true,
      "required": ["measurable", "basis", "percent", "hit", "found", "minimum", "passed"],
      "properties": {
        "measurable": {"type": "boolean"},
        "basis": {"type": "string"},
        "percent": {"type": "number", "minimum": 0, "maximum": 100},
        "hit": {"type": "integer", "minimum": 0},
        "found": {"type": "integer", "minimum": 0},
        "minimum": {"type": "number", "minimum": 0, "maximum": 100},
        "passed": {"type": "boolean"}
      }
    },
    "coverageSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schemaVersion", "enabled", "detailArtifact",
        "linesFound", "linesHit", "linePercent",
        "functionsFound", "functionsHit", "functionPercent",
        "statementSitesFound", "statementSitesHit", "statementSitePercent",
        "statementSitesInstrumented", "statementSiteInstrumentationPercent",
        "statementSiteInstrumentationComplete", "branchesFound", "branchesHit",
        "branchPercent", "branchMode", "branchSitesEligible",
        "branchSitesInstrumented", "branchInstrumentationPercent",
        "branchInstrumentationComplete", "filesFound", "filesLoaded",
        "filesWithStatements", "functionsEligible", "functionsInstrumented",
        "functionInstrumentationPercent", "statementMode",
        "statementFunctionsEligible", "statementFunctionsInstrumented",
        "statementInstrumentationPercent", "statementInstrumentationComplete",
        "fallbackCounts", "gates", "allowPartialLines", "partialLines",
        "partialBranches", "basis", "minimum", "passed"
      ],
      "properties": {
        "schemaVersion": {"const": 2},
        "enabled": {"const": true},
        "detailArtifact": {"const": "coverage.json"},
        "linesFound": {"type": "integer", "minimum": 0},
        "linesHit": {"type": "integer", "minimum": 0},
        "linePercent": {"type": "number", "minimum": 0, "maximum": 100},
        "functionsFound": {"type": "integer", "minimum": 0},
        "functionsHit": {"type": "integer", "minimum": 0},
        "functionPercent": {"type": "number", "minimum": 0, "maximum": 100},
        "statementSitesFound": {"type": "integer", "minimum": 0},
        "statementSitesHit": {"type": "integer", "minimum": 0},
        "statementSitePercent": {"type": "number", "minimum": 0, "maximum": 100},
        "statementSitesInstrumented": {"type": "integer", "minimum": 0},
        "statementSiteInstrumentationPercent": {"type": "number", "minimum": 0, "maximum": 100},
        "statementSiteInstrumentationComplete": {"type": "boolean"},
        "branchesFound": {"type": "integer", "minimum": 0},
        "branchesHit": {"type": "integer", "minimum": 0},
        "branchPercent": {"type": "number", "minimum": 0, "maximum": 100},
        "branchMode": {"type": "boolean"},
        "branchSitesEligible": {"type": "integer", "minimum": 0},
        "branchSitesInstrumented": {"type": "integer", "minimum": 0},
        "branchInstrumentationPercent": {"type": "number", "minimum": 0, "maximum": 100},
        "branchInstrumentationComplete": {"type": "boolean"},
        "filesFound": {"type": "integer", "minimum": 0},
        "filesLoaded": {"type": "integer", "minimum": 0},
        "filesWithStatements": {"type": "integer", "minimum": 0},
        "functionsEligible": {"type": "integer", "minimum": 0},
        "functionsInstrumented": {"type": "integer", "minimum": 0},
        "functionInstrumentationPercent": {"type": "number", "minimum": 0, "maximum": 100},
        "statementMode": {"type": "boolean"},
        "statementFunctionsEligible": {"type": "integer", "minimum": 0},
        "statementFunctionsInstrumented": {"type": "integer", "minimum": 0},
        "statementInstrumentationPercent": {"type": "number", "minimum": 0, "maximum": 100},
        "statementInstrumentationComplete": {"type": "boolean"},
        "fallbackCounts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "gates": {
          "type": "object",
          "required": ["functions", "lines", "completeness", "branches", "branchCompleteness"],
          "properties": {
            "functions": {"$ref": "#/$defs/coverageGate"},
            "lines": {"$ref": "#/$defs/coverageGate"},
            "completeness": {"$ref": "#/$defs/coverageGate"},
            "branches": {"$ref": "#/$defs/coverageGate"},
            "branchCompleteness": {"$ref": "#/$defs/coverageGate"}
          },
          "additionalProperties": true
        },
        "allowPartialLines": {"type": "boolean"},
        "partialLines": {"type": "boolean"},
        "partialBranches": {"type": "boolean"},
        "basis": {"type": "string"},
        "minimum": {"type": "number", "minimum": 0, "maximum": 100},
        "passed": {"type": "boolean"}
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceComplete", "omittedSections", "omittedTestFields", "boundedFields"],
      "properties": {
        "evidenceComplete": {"type": "boolean"},
        "omittedSections": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "omittedTestFields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "boundedFields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "telemetryTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "description", "status", "message", "durationSeconds", "assertsRun", "file", "line", "testId", "caseId", "kind", "attempts", "retried", "flaky"],
      "properties": {
        "suite": {"type": "string"},
        "description": {"type": "string"},
        "status": {"enum": ["pass", "fail", "error", "skip", "pending"]},
        "message": {"type": "string"},
        "durationSeconds": {"type": "number", "minimum": 0},
        "assertsRun": {"type": "integer", "minimum": 0},
        "file": {"type": "string"},
        "line": {"type": ["integer", "null"]},
        "testId": {"type": "string", "pattern": "^test_[0-9a-f]{32}$"},
        "caseId": {"type": "string"},
        "kind": {"type": "string"},
        "attempts": {"type": "integer", "minimum": 1},
        "retried": {"type": "boolean"},
        "flaky": {"type": "boolean"},
        "startedAt": {"type": ["string", "null"], "format": "date-time"},
        "finishedAt": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "startedAt", "finishedAt", "durationSeconds", "hostname", "cwd", "qVersion", "qRelease", "os", "resqVersion", "vcs", "ci", "config"],
      "properties": {
        "id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
        "startedAt": {"type": "string", "format": "date-time"},
        "finishedAt": {"type": "string", "format": "date-time"},
        "durationSeconds": {"type": "number", "minimum": 0},
        "wallDurationSeconds": {"type": "number", "minimum": 0},
        "hostname": {"type": "string"},
        "cwd": {"type": "string"},
        "qVersion": {"type": "string"},
        "qRelease": {"type": "string"},
        "os": {"type": "string"},
        "resqVersion": {"type": "string"},
        "labels": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^(?!resq\\.|vcs\\.|ci\\.|__)[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "additionalProperties": {"type": "string", "maxLength": 256}
        },
        "vcs": {
          "type": "object",
          "required": ["sha", "branch", "dirty"],
          "properties": {
            "sha": {"type": "string"},
            "branch": {"type": "string"},
            "dirty": {"type": "boolean"},
            "status": {"enum": ["ok", "unavailable", "disabled"]}
          },
          "additionalProperties": false
        },
        "ci": {"type": "object"},
        "config": {"type": "object"},
        "ordering": {
          "type": "object",
          "additionalProperties": true,
          "required": ["randomized", "seed", "algorithm"],
          "properties": {
            "randomized": {"type": "boolean"},
            "seed": {"type": "integer", "minimum": 0},
            "algorithm": {"const": "md5-counter-v1"}
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": true,
          "required": ["mode", "stateFile", "historyStatus", "priorFailedCount", "applied", "selectedTestCount"],
          "properties": {
            "mode": {"enum": ["all", "lastFailed", "failedFirst"]},
            "stateFile": {"type": "string"},
            "historyStatus": {"enum": ["ok", "missing", "invalid", "unsupported"]},
            "priorFailedCount": {"type": "integer", "minimum": 0},
            "applied": {"type": "boolean"},
            "selectedTestCount": {"type": "integer", "minimum": 0}
          }
        },
        "shard": {
          "type": "object",
          "additionalProperties": true,
          "required": ["index", "count", "algorithm", "allFileCount", "selectedFileCount", "selectedFiles"],
          "properties": {
            "index": {"type": "integer", "minimum": -1},
            "count": {"type": "integer", "minimum": 1},
            "unit": {"enum": ["file", "test", "case"]},
            "algorithm": {"enum": ["sorted-index-mod-v1", "stable-id-weighted-hash-v1"]},
            "allFileCount": {"type": "integer", "minimum": 0},
            "selectedFileCount": {"type": "integer", "minimum": 0},
            "allUnitCount": {"type": "integer", "minimum": 0},
            "selectedUnitCount": {"type": "integer", "minimum": 0},
            "selectedFiles": {"type": "array", "items": {"type": "string"}},
            "selectedExecutionIds": {"type": "array", "items": {"type": "string", "pattern": "^(?:test|case)_[0-9a-f]{32}$"}}
          }
        },
        "completion": {"$ref": "#/$defs/completion"}
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "complete", "truncated", "reason", "selectedTestCount", "resultCount", "missingExecutionIds"],
      "properties": {
        "state": {"enum": ["complete", "incomplete"]},
        "complete": {"type": "boolean"},
        "truncated": {"type": "boolean"},
        "reason": {"enum": ["completed", "describeOnly", "emptyShard", "frameworkError", "loadError", "isolationError", "failFast", "missingResults"]},
        "selectedTestCount": {"type": "integer", "minimum": 0},
        "resultCount": {"type": "integer", "minimum": 0},
        "missingExecutionIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:test|case)_[0-9a-f]{32}$"}}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["suiteCount", "testCount", "assertionCount", "passCount", "failCount", "errorCount", "skipCount", "duration", "durationSeconds"],
      "properties": {
        "suiteCount": {"type": "integer", "minimum": 0},
        "testCount": {"type": "integer", "minimum": 0},
        "assertionCount": {"type": "integer", "minimum": 0},
        "passCount": {"type": "integer", "minimum": 0},
        "failCount": {"type": "integer", "minimum": 0},
        "errorCount": {"type": "integer", "minimum": 0},
        "skipCount": {"type": "integer", "minimum": 0},
        "duration": {"type": "string"},
        "durationSeconds": {"type": "number", "minimum": 0},
        "testDurationSumSeconds": {"type": "number", "minimum": 0}
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": true,
      "required": ["suite", "description", "status", "message", "time", "durationSeconds", "failures", "assertsRun", "file", "line", "namespace", "tags", "output", "testId", "caseId", "kind", "attempts", "retried", "flaky", "attemptHistory", "parameterCases", "property", "diagnostics", "snapshots", "benchmark"],
      "properties": {
        "suite": {"type": "string"},
        "description": {"type": "string"},
        "status": {"enum": ["pass", "fail", "error", "skip", "pending"]},
        "message": {"type": "string"},
        "time": {"type": "string"},
        "durationSeconds": {"type": "number", "minimum": 0},
        "startedAt": {"type": ["string", "null"], "format": "date-time"},
        "finishedAt": {"type": ["string", "null"], "format": "date-time"},
        "failures": {"type": "array", "items": {"type": "string"}},
        "assertsRun": {"type": "integer", "minimum": 0},
        "file": {"type": "string"},
        "line": {"type": ["integer", "null"]},
        "namespace": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "output": {"type": "string"},
        "testId": {"type": "string", "pattern": "^test_[0-9a-f]{32}$"},
        "caseId": {"type": "string"},
        "kind": {"type": "string"},
        "parameters": {"type": "object"},
        "attempts": {"type": "integer", "minimum": 1},
        "retried": {"type": "boolean"},
        "flaky": {"type": "boolean"},
        "attemptHistory": {"type": "array", "items": {"$ref": "#/$defs/attempt"}},
        "parameterCases": {"type": "array", "items": {"$ref": "#/$defs/case"}},
        "property": {
          "oneOf": [
            {"type": "object", "not": {"required": ["generatorProtocol"]}},
            {"$ref": "#/$defs/property"}
          ]
        },
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "snapshots": {"type": "array", "items": {"$ref": "#/$defs/snapshot"}},
        "benchmark": {
          "oneOf": [
            {"type": "object", "not": {"required": ["benchmarkId"]}},
            {"$ref": "#/$defs/benchmarkTelemetry"}
          ]
        },
        "quarantine": {
          "oneOf": [
            {"type": "object", "maxProperties": 0},
            {"$ref": "#/$defs/quarantine"}
          ]
        }
      }
    },
    "quarantine": {
      "type": "object",
      "required": ["schemaVersion", "state", "active", "nonBlocking", "observations", "passes", "failures", "flakes", "owner", "reason", "evidence", "issue", "createdAt", "expiresAt"],
      "properties": {
        "schemaVersion": {"const": 2},
        "state": {"enum": ["insufficient", "healthy", "suspect", "quarantined", "expired"]},
        "active": {"type": "boolean"},
        "nonBlocking": {"type": "boolean"},
        "observations": {"type": "integer", "minimum": 0},
        "passes": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0},
        "flakes": {"type": "integer", "minimum": 0},
        "owner": {"type": "string"},
        "reason": {"type": "string"},
        "evidence": {},
        "issue": {"type": "string"},
        "createdAt": {"type": "string"},
        "expiresAt": {"type": "string"}
      },
      "additionalProperties": true
    },
    "flake": {
      "type": "object",
      "required": ["schemaVersion", "historyPath", "historyStatus", "manifestPath", "manifestStatus", "nonBlockingEnabled", "evidenceMin", "failureMin", "window", "healthy", "suspect", "quarantined", "expired", "insufficient", "proposalCount"],
      "properties": {
        "schemaVersion": {"const": 2},
        "historyPath": {"type": "string"},
        "historyStatus": {"enum": ["ok", "missing", "invalid", "unsupported"]},
        "manifestPath": {"type": "string"},
        "manifestStatus": {"enum": ["ok", "missing", "invalid", "unsupported"]},
        "nonBlockingEnabled": {"type": "boolean"},
        "evidenceMin": {"type": "integer", "minimum": 2},
        "failureMin": {"type": "integer", "minimum": 1},
        "window": {"type": "integer", "minimum": 2},
        "healthy": {"type": "integer", "minimum": 0},
        "suspect": {"type": "integer", "minimum": 0},
        "quarantined": {"type": "integer", "minimum": 0},
        "expired": {"type": "integer", "minimum": 0},
        "insufficient": {"type": "integer", "minimum": 0},
        "proposalCount": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "property": {
      "type": "object",
      "required": [
        "seed", "runs", "maxFailRate", "failRate", "passCount", "failCount",
        "failedInputs", "shrunkInput", "generatorProtocol", "replayToken",
        "replayTokens", "originalInput", "minimalInput", "shrinkSteps",
        "shrinkCandidates", "shrinkTermination", "failureSignature",
        "shrinkDurationMs"
      ],
      "properties": {
        "seed": {"type": "integer"},
        "runs": {"type": "integer", "minimum": 0},
        "maxFailRate": {"type": "number", "minimum": 0, "maximum": 1},
        "failRate": {"type": "number", "minimum": 0, "maximum": 1},
        "passCount": {"type": "integer", "minimum": 0},
        "failCount": {"type": "integer", "minimum": 0},
        "failedInputs": {"type": "array"},
        "shrunkInput": {},
        "generatorProtocol": {"const": "resq-generator-v1"},
        "replayToken": {"type": "string", "pattern": "^(?:resq-pbt-v1/-?[0-9]+/[0-9]+)?$"},
        "replayTokens": {"type": "array", "items": {"type": "string", "pattern": "^resq-pbt-v1/-?[0-9]+/[0-9]+$"}},
        "originalInput": {},
        "minimalInput": {},
        "shrinkSteps": {"type": "integer", "minimum": 0},
        "shrinkCandidates": {"type": "integer", "minimum": 0},
        "shrinkTermination": {"enum": ["notRun", "minimal", "stepLimit", "candidateLimit", "timeLimit"]},
        "failureSignature": {"type": "string"},
        "shrinkDurationMs": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "attempt": {
      "type": "object",
      "required": ["attempt", "status", "duration", "durationSeconds", "message", "failures", "assertsRun"],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1},
        "status": {"enum": ["pass", "fail", "error", "skip", "pending"]},
        "duration": {"type": "string"},
        "durationSeconds": {"type": "number", "minimum": 0},
        "startedAt": {"type": ["string", "null"], "format": "date-time"},
        "finishedAt": {"type": ["string", "null"], "format": "date-time"},
        "message": {"type": "string"},
        "failures": {"type": "array", "items": {"type": "string"}},
        "assertsRun": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "case": {
      "type": "object",
      "required": ["caseId", "index", "parameters", "status", "message", "failures", "assertsRun", "duration", "durationSeconds"],
      "properties": {
        "caseId": {"type": "string", "pattern": "^case_[0-9a-f]{32}$"},
        "index": {"type": "integer", "minimum": 0},
        "parameters": {"type": "object"},
        "status": {"enum": ["pass", "fail", "error"]},
        "message": {"type": "string"},
        "failures": {"type": "array", "items": {"type": "string"}},
        "assertsRun": {"type": "integer", "minimum": 0},
        "duration": {"type": "string"},
        "durationSeconds": {"type": "number", "minimum": 0},
        "startedAt": {"type": ["string", "null"], "format": "date-time"},
        "finishedAt": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": true
    },
    "diagnostic": {
      "type": "object",
      "required": ["type", "severity", "phase", "message", "data"],
      "properties": {
        "type": {"type": "string"},
        "severity": {"enum": ["info", "warning", "error"]},
        "phase": {"type": "string"},
        "message": {"type": "string"},
        "data": {},
        "timestamp": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    },
    "snapshot": {
      "type": "object",
      "required": ["backend", "name", "status", "path", "timestamp"],
      "properties": {
        "backend": {"enum": ["binary", "text"]},
        "name": {"type": "string"},
        "status": {"enum": ["created", "updated", "matched", "missing", "mismatch"]},
        "path": {"type": "string"},
        "root": {"type": "string"},
        "timestamp": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    },
    "snapshotInventory": {
      "type": "object",
      "required": ["schemaVersion", "kind", "enabled", "generatedAt", "complete", "completenessReasons", "roots", "entries", "counts", "gate"],
      "properties": {
        "schemaVersion": {"enum": [1, 2]},
        "kind": {"const": "resq-snapshot-inventory"},
        "enabled": {"type": "boolean"},
        "generatedAt": {"type": "string", "format": "date-time"},
        "complete": {"type": "boolean"},
        "completenessReasons": {"type": "array", "items": {"type": "string"}},
        "roots": {"type": "array", "items": {"type": "object"}},
        "entries": {"type": "array", "items": {
          "type": "object",
          "required": ["backend", "name", "path", "root", "absoluteRoot", "absolutePath", "status", "referenced", "declared", "dynamic", "exists", "unsafe", "executionIds", "observedStatuses"],
          "properties": {
            "backend": {"enum": ["binary", "text"]},
            "status": {"enum": ["referenced", "missing", "obsolete", "unverified"]},
            "unsafe": {"type": "boolean"}
          },
          "additionalProperties": true
        }},
        "counts": {"type": "object"},
        "gate": {"type": "object", "required": ["enabled", "passed", "reasons"]}
      },
      "additionalProperties": true
    },
    "benchmarkSamples": {
      "type": "object",
      "required": ["timeNs", "retainedBytes", "heapGrowthBytes"],
      "properties": {
        "timeNs": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "retainedBytes": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "heapGrowthBytes": {"type": "array", "items": {"type": "integer", "minimum": 0}}
      },
      "additionalProperties": true
    },
    "benchmarkWorkload": {
      "type": "object",
      "required": ["runs", "warmup", "gcBefore", "gcEach", "space"],
      "properties": {
        "runs": {"type": "integer", "minimum": 1},
        "warmup": {"type": "integer", "minimum": 0},
        "gcBefore": {"type": "boolean"},
        "gcEach": {"type": "boolean"},
        "space": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "benchmarkEnvironment": {
      "type": "object",
      "required": ["qVersion", "qRelease", "os", "architecture", "cpuModel", "logicalCores", "fingerprint"],
      "properties": {
        "qVersion": {"type": "string"},
        "qRelease": {"type": "string"},
        "os": {"type": "string"},
        "architecture": {"type": "string"},
        "cpuModel": {"type": "string"},
        "logicalCores": {"type": ["integer", "null"]},
        "fingerprint": {"type": "string", "pattern": "^environment_[0-9a-f]{32}$"}
      },
      "additionalProperties": true
    },
    "benchmarkComparison": {
      "type": "object",
      "required": ["benchmarkId", "testId", "file", "suite", "description", "classification", "reason", "baselineFound", "comparable", "environmentMatch", "workloadMatch", "environmentAccepted", "metric", "unit", "baselineMedian", "currentMedian", "relativeChangePercent", "u", "z", "pValue", "adjustedPValue", "alpha", "practicalEffectPercent", "baselineRuns", "currentRuns"],
      "properties": {
        "benchmarkId": {"type": "string", "pattern": "^benchmark_[0-9a-f]{32}$"},
        "testId": {"type": "string", "pattern": "^test_[0-9a-f]{32}$"},
        "classification": {"enum": ["improved", "stable", "inconclusive", "regressed"]},
        "reason": {"type": "string"},
        "baselineFound": {"type": "boolean"},
        "comparable": {"type": "boolean"},
        "environmentMatch": {"type": "boolean"},
        "workloadMatch": {"type": "boolean"},
        "environmentAccepted": {"type": "boolean"},
        "metric": {"const": "timeNs"},
        "unit": {"const": "nanoseconds"},
        "pValue": {"type": "number", "minimum": 0, "maximum": 1},
        "adjustedPValue": {"type": "number", "minimum": 0, "maximum": 1},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "baselineRuns": {"type": "integer", "minimum": 0},
        "currentRuns": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "benchmarkTelemetry": {
      "type": "object",
      "required": ["benchmarkId", "testId", "file", "suite", "description", "status", "runs", "metric", "unit", "measurement", "limits", "workload", "samples", "comparison"],
      "properties": {
        "benchmarkId": {"type": "string", "pattern": "^benchmark_[0-9a-f]{32}$"},
        "testId": {"type": "string", "pattern": "^test_[0-9a-f]{32}$"},
        "status": {"enum": ["pass", "fail", "error"]},
        "runs": {"type": "integer", "minimum": 1},
        "metric": {"const": "time"},
        "unit": {"const": "nanoseconds"},
        "measurement": {"type": "object"},
        "limits": {"type": "object"},
        "workload": {"$ref": "#/$defs/benchmarkWorkload"},
        "samples": {"$ref": "#/$defs/benchmarkSamples"},
        "comparison": {
          "oneOf": [
            {"type": "object", "maxProperties": 0},
            {"$ref": "#/$defs/benchmarkComparison"}
          ]
        }
      },
      "additionalProperties": true
    },
    "legacyBenchmarkMeasurement": {
      "type": "object",
      "not": {"required": ["benchmarkId"]},
      "additionalProperties": true
    },
    "benchmarkMeasurement": {
      "type": "object",
      "required": ["benchmarkId", "testId", "file", "suite", "description", "metric", "unit", "runs", "avgTimeMs", "minTimeMs", "medTimeMs", "maxTimeMs", "devTimeMs", "avgSpaceBytes", "maxSpaceBytes", "timeLimitMs", "spaceLimitBytes", "workload", "samples", "measurement", "environment", "comparison"],
      "properties": {
        "benchmarkId": {"type": "string", "pattern": "^benchmark_[0-9a-f]{32}$"},
        "testId": {"type": "string", "pattern": "^test_[0-9a-f]{32}$"},
        "metric": {"const": "time"},
        "unit": {"const": "nanoseconds"},
        "runs": {"type": "integer", "minimum": 1},
        "workload": {"$ref": "#/$defs/benchmarkWorkload"},
        "samples": {"$ref": "#/$defs/benchmarkSamples"},
        "environment": {"$ref": "#/$defs/benchmarkEnvironment"},
        "comparison": {
          "oneOf": [
            {"type": "object", "maxProperties": 0},
            {"$ref": "#/$defs/benchmarkComparison"}
          ]
        }
      },
      "additionalProperties": true
    },
    "benchmarkAnalysis": {
      "type": "object",
      "required": ["schemaVersion", "kind", "enabled", "baselinePath", "baselineStatus", "method", "config", "environment", "counts", "comparisons", "gate"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "resq-benchmark-analysis"},
        "enabled": {"type": "boolean"},
        "baselinePath": {"type": "string"},
        "baselineStatus": {"enum": ["disabled", "notLoaded", "ok", "missing", "invalid", "unsupported"]},
        "method": {"type": "object"},
        "config": {"type": "object"},
        "environment": {"$ref": "#/$defs/benchmarkEnvironment"},
        "counts": {"type": "object"},
        "comparisons": {"type": "array", "items": {"$ref": "#/$defs/benchmarkComparison"}},
        "gate": {
          "type": "object",
          "required": ["enabled", "deferred", "passed", "reasons"],
          "properties": {
            "enabled": {"type": "boolean"},
            "deferred": {"type": "boolean"},
            "passed": {"type": "boolean"},
            "reasons": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "manifest": {
      "type": "object",
      "required": ["schemaVersion", "kind", "digest", "digestAlgorithm", "identityAlgorithm", "identityCodec", "frameworkVersion", "revision", "shard", "files", "tests"],
      "properties": {
        "schemaVersion": {"const": 3},
        "kind": {"const": "resq-execution-manifest"},
        "digest": {"type": "string", "pattern": "^manifest_[0-9a-f]{32}$"},
        "digestAlgorithm": {"const": "md5-source-topology-v3"},
        "identityAlgorithm": {"const": "resq-test-case-id-v3"},
        "identityCodec": {
          "type": "object",
          "required": ["name", "version", "qVersion", "qRelease", "ipcSerialization", "capabilityLevel"],
          "properties": {
            "name": {"const": "resq-value-v1+q-ipc-leaves"},
            "version": {"const": 1},
            "qVersion": {"type": "string", "minLength": 1},
            "qRelease": {"type": "string", "minLength": 1},
            "ipcSerialization": {"const": "q unary -8!/-9!"},
            "capabilityLevel": {"const": "local unary serialization; no negotiated IPC connection capability"}
          },
          "additionalProperties": false
        },
        "frameworkVersion": {"type": "string"},
        "revision": {"type": "object"},
        "shard": {"type": "object"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fileId", "path", "sourceDigest", "assignedShard", "selected", "shardable"],
            "properties": {
              "fileId": {"type": "string", "pattern": "^file_[0-9a-f]{32}$"},
              "path": {"type": "string", "minLength": 1},
              "sourceDigest": {"type": "string", "pattern": "^(?:[0-9a-f]{32})?$"},
              "assignedShard": {"type": "integer", "minimum": -1},
              "selected": {"type": "boolean"},
              "shardable": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["executionId", "testId", "caseId", "suiteId", "fileId", "file", "suite", "description", "line", "kind", "parameters", "tags", "shardKey", "assignedShard", "selected", "shardable"],
            "properties": {
              "executionId": {"type": "string", "pattern": "^(?:test|case)_[0-9a-f]{32}$"},
              "testId": {"type": "string", "pattern": "^test_[0-9a-f]{32}$"},
              "caseId": {"type": "string"},
              "suiteId": {"type": "string", "pattern": "^suite_[0-9a-f]{32}$"},
              "fileId": {"type": "string", "pattern": "^file_[0-9a-f]{32}$"},
              "file": {"type": "string"},
              "suite": {"type": "string"},
              "description": {"type": "string"},
              "line": {"type": ["integer", "null"]},
              "kind": {"type": "string"},
              "parameters": {"type": "object"},
              "tags": {"type": "array", "items": {"type": "string"}},
              "shardKey": {"type": "string"},
              "assignedShard": {"type": "integer", "minimum": 0},
              "selected": {"type": "boolean"},
              "shardable": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "event": {
      "type": "object",
      "required": ["schemaVersion", "sequence", "type", "runId", "entityId", "parentId", "occurredAt", "payload"],
      "properties": {
        "schemaVersion": {"const": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "type": {"type": "string", "pattern": "^[a-z]+\\.[a-z]+$"},
        "runId": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
        "entityId": {"type": "string"},
        "parentId": {"type": "string"},
        "occurredAt": {"type": "string", "format": "date-time"},
        "payload": {"type": "object"}
      },
      "additionalProperties": true
    }
  }
}
