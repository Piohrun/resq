{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Piohrun/resq/docs/schema/resq-release-audit-v1.schema.json",
  "title": "resQ release audit v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "framework",
    "status",
    "commit",
    "startedAt",
    "finishedAt",
    "durationSeconds",
    "qVersion",
    "resqVersion",
    "environment",
    "qualificationScope",
    "selfSuite",
    "isolatedSuite",
    "suiteReconciliation",
    "differentialCorpus",
    "preprocessingBudget",
    "coverage",
    "coverageReconciliation",
    "soak",
    "reportScale",
    "installation",
    "schemas",
    "archive",
    "steps"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "resq-release-audit"},
    "framework": {"const": "resQ"},
    "status": {"const": "pass"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "startedAt": {"type": "string"},
    "finishedAt": {"type": "string"},
    "durationSeconds": {"type": "number", "minimum": 0},
    "qVersion": {"type": "string"},
    "resqVersion": {"type": "string"},
    "environment": {"type": "object"},
    "qualificationScope": {
      "type": "object",
      "required": ["qualified", "unqualified"],
      "properties": {
        "qualified": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "unqualified": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "selfSuite": {"type": "object"},
    "isolatedSuite": {"type": "object"},
    "suiteReconciliation": {"type": "object"},
    "differentialCorpus": {"type": "object"},
    "preprocessingBudget": {"type": "object"},
    "coverage": {"type": "object"},
    "coverageReconciliation": {"type": "object"},
    "soak": {"type": "object"},
    "reportScale": {"type": "object"},
    "installation": {"type": "object"},
    "schemas": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "archive": {"type": "object"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "command", "durationSeconds", "log", "logSha256"],
        "properties": {
          "name": {"type": "string"},
          "status": {"const": "pass"},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "durationSeconds": {"type": "number", "minimum": 0},
          "log": {"type": "string"},
          "logSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "additionalProperties": true
}
